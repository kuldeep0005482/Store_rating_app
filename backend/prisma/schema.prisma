generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  STORE_OWNER
}

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(60)
  email        String    @unique @db.VarChar(255)
  address      String    @db.VarChar(400)
  passwordHash String    @map("password_hash")
  role         Role      @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  ownedStores  Store[]   @relation("StoreOwner")
  ratings      Rating[]
  replies      Reply[]

  @@index([name])
  @@index([role])
  @@map("users")
}

model Store {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  email       String   @db.VarChar(255)
  address     String   @db.VarChar(400)
  ownerId     Int?     @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User?    @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ratings     Rating[]

  @@index([name])
  @@index([address])
  @@index([ownerId])
  @@map("stores")
}

model Rating {
  id        Int      @id @default(autoincrement())
  value     Int
  comment   String?  @db.VarChar(500)
  userId    Int      @map("user_id")
  storeId   Int      @map("store_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  replies   Reply[]

  @@unique([userId, storeId])
  @@index([storeId])
  @@index([userId])
  @@map("ratings")
}

model Reply {
  id        Int      @id @default(autoincrement())
  comment   String   @db.VarChar(500)
  ratingId  Int      @map("rating_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ratingId])
  @@index([userId])
  @@map("replies")
}
